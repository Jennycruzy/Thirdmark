pragma language_version 0.22;

import CompactStandardLibrary;

// This circuit checks the group relation used by the client-side blinded OPRF.
// The inverse scalar is supplied by the client after deriving it from the
// source-backed Jubjub modulus; it is never computed in Compact. The pinned
// runtime's missing modulus export is recorded in docs/FINDINGS.md.
export ledger roundTripAccepted: Boolean;

witness blindingScalar(): Field;
witness issuerScalar(): Field;
witness unblindingScalar(): Field;

export pure circuit subjectPoint(subject: Bytes<32>): JubjubPoint {
  return hashToCurve<Bytes<32>>(subject);
}

export circuit oprfRoundTrip(subject: Bytes<32>): Boolean {
  const point = subjectPoint(subject);
  const blinded = ecMul(point, blindingScalar());
  const issuerOutput = ecMul(blinded, issuerScalar());
  const unblinded = ecMul(issuerOutput, unblindingScalar());
  const expected = ecMul(point, issuerScalar());
  // Compare coordinates explicitly. The generated runtime represents a
  // JubjubPoint as an x/y value, so object identity is not a curve equality
  // check across separate ecMul calls.
  const accepted = disclose(
    jubjubPointX(unblinded) == jubjubPointX(expected) &&
    jubjubPointY(unblinded) == jubjubPointY(expected)
  );
  roundTripAccepted = accepted;
  return accepted;
}
