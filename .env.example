# Thirdmark local configuration. Leave values empty until a source-backed
# deployment environment is selected. Never put wallet material in this file.
MIDNIGHT_NETWORK=
MIDNIGHT_INDEXER_URL=
MIDNIGHT_NODE_URL=
MIDNIGHT_PROOF_SERVER_URL=

# Public browser configuration. These values are deployment metadata, not secrets.
VITE_CONTRACT_ADDRESS=
# Local Vite uses /__thirdmark_issuer; a deployed browser build uses an
# explicitly configured HTTPS issuer URL.
VITE_ISSUER_URL=
VITE_ISSUER_PUBLIC_KEY_X=
VITE_ISSUER_PUBLIC_KEY_Y=
# Local Vite uses /__thirdmark_registry/v1/cac/search; deployed builds use the
# explicitly configured registry adapter URL.
VITE_REGISTRY_ADAPTER_URL=

# Deliberately invalid, synthetic-only subject for recordings and local testing.
# Keep this visibly labelled in the interface. Never replace it with a real RC number.
VITE_SYNTHETIC_SUBJECT_NAME=
VITE_SYNTHETIC_SUBJECT_RC=

# CAC public-search adapter runtime. These are public endpoints and local binding
# settings; never put wallet or issuer secrets in this file.
THIRDMARK_CAC_PUBLIC_SEARCH_URL=
THIRDMARK_REGISTRY_HOST=
THIRDMARK_REGISTRY_PORT=
THIRDMARK_REGISTRY_ALLOWED_ORIGIN=
