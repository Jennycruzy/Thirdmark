// Thirdmark — threshold-gated corroboration on Midnight.
//
// Report contents never enter Compact. The contract authenticates an issuer
// evaluated OPRF point, derives an anonymous slot from it, stores only the
// client-encrypted envelope, and discloses the threshold predicate.

pragma language_version 0.22;

import CompactStandardLibrary;

// A bounded witness is used because Compact 0.30.0 exposes List as a ledger
// ADT, not as a private witness collection. Four entries are enough for the
// Wave 1 browser journey while keeping delegated 1AM proving within the
// connector's payload/depth limits. This is a circuit bound, not an assertion
// that a production filer history should be capped here.
export struct FilingHistory {
  slots: Vector<4, Bytes<32>>;
  commitmentSalts: Vector<4, Bytes<32>>;
  length: Uint<8>;
}

// Chaum–Pedersen/DLEQ proof that the issuer used the same scalar for the
// issuer public key and the blinded OPRF evaluation. This is implemented from
// the ledger-v8 primitive set (ecAdd, ecMul, ecMulGenerator, transientHash),
// because the selected safe compiler predates the standard-library Schnorr
// verifier introduced later.
export struct DleqProof {
  announcementGenerator: JubjubPoint;
  announcementBlinded: JubjubPoint;
  response: Field;
}

struct SlotKeyInput {
  domain: Bytes<32>;
  pointX: Field;
  pointY: Field;
}

struct DleqChallengeInput {
  domain: Bytes<32>;
  issuerKeyX: Field;
  issuerKeyY: Field;
  blindedX: Field;
  blindedY: Field;
  evaluatedX: Field;
  evaluatedY: Field;
  announcementGeneratorX: Field;
  announcementGeneratorY: Field;
  announcementBlindedX: Field;
  announcementBlindedY: Field;
}

struct NullifierInput {
  domain: Bytes<32>;
  filerSecret: Bytes<32>;
  slotKey: Bytes<32>;
}

struct FilerIdInput {
  domain: Bytes<32>;
  filerSecret: Bytes<32>;
}

struct CiphertextIdInput {
  domain: Bytes<32>;
  ciphertext: Bytes<128>;
}

struct EntryKeyInput {
  domain: Bytes<32>;
  slotKey: Bytes<32>;
  index: Uint<8>;
}

// Public configuration. These are sealed: they are visible, set once at
// construction, and cannot be changed by an operator or an upgrade path.
export sealed ledger issuerKeyX: Field;
export sealed ledger issuerKeyY: Field;
export sealed ledger threshold: Uint<8>;

// Public state contains only anti-replay identifiers, opaque ciphertext,
// aggregate slot state, and commitments. There is no identity-to-entry map.
export ledger filed: Set<Bytes<32>>;
export ledger ciphertextsUsed: Set<Bytes<32>>;
export ledger entries: Map<Bytes<32>, Bytes<128>>;
export ledger slotFilled: Map<Bytes<32>, Uint<8>>;
export ledger unlocked: Set<Bytes<32>>;
export ledger history: Map<Bytes<32>, Bytes<32>>;

constructor(configIssuerKeyX: Field, configIssuerKeyY: Field, configThreshold: Uint<8>) {
  assert(configThreshold >= 2 as Uint<8>, "threshold must be at least two");
  issuerKeyX = disclose(configIssuerKeyX);
  issuerKeyY = disclose(configIssuerKeyY);
  threshold = disclose(configThreshold);
}

// Private inputs are supplied by the wallet witness implementation.
witness filerSecret(): Bytes<32>;
witness filingHistory(): FilingHistory;
witness previousHistorySalt(): Bytes<32>;
witness nextHistorySalt(): Bytes<32>;
witness blindedOprfPoint(): JubjubPoint;
witness evaluatedOprfPoint(): JubjubPoint;
witness unblindingScalar(): Field;
witness issuerDleqProof(): DleqProof;

export pure circuit slotKeyFromPoint(point: JubjubPoint): Bytes<32> {
  return persistentHash<SlotKeyInput>(SlotKeyInput {
    domain: pad(32, "thirdmark:slot:v1"),
    pointX: jubjubPointX(point),
    pointY: jubjubPointY(point)
  });
}

export pure circuit filerIdFromSecret(secret: Bytes<32>): Bytes<32> {
  return persistentHash<FilerIdInput>(FilerIdInput {
    domain: pad(32, "thirdmark:filer:v1"),
    filerSecret: secret
  });
}

export pure circuit filerNullifier(secret: Bytes<32>, slotKey: Bytes<32>): Bytes<32> {
  return persistentHash<NullifierInput>(NullifierInput {
    domain: pad(32, "thirdmark:nullifier:v1"),
    filerSecret: secret,
    slotKey: slotKey
  });
}

export pure circuit ciphertextId(ciphertext: Bytes<128>): Bytes<32> {
  return persistentHash<CiphertextIdInput>(CiphertextIdInput {
    domain: pad(32, "thirdmark:ciphertext:v1"),
    ciphertext: ciphertext
  });
}

export pure circuit entryKey(slotKey: Bytes<32>, index: Uint<8>): Bytes<32> {
  return persistentHash<EntryKeyInput>(EntryKeyInput {
    domain: pad(32, "thirdmark:entry:v1"),
    slotKey: slotKey,
    index: index
  });
}

pure circuit pointCoordinatesEqual(left: JubjubPoint, right: JubjubPoint): Boolean {
  return jubjubPointX(left) == jubjubPointX(right) &&
    jubjubPointY(left) == jubjubPointY(right);
}

export pure circuit dleqChallenge(
  issuerKey: JubjubPoint,
  blinded: JubjubPoint,
  evaluated: JubjubPoint,
  announcementGenerator: JubjubPoint,
  announcementBlinded: JubjubPoint
): Field {
  const challengeField = transientHash<DleqChallengeInput>(DleqChallengeInput {
    domain: pad(32, "thirdmark:oprf:dleq:v1"),
    issuerKeyX: jubjubPointX(issuerKey),
    issuerKeyY: jubjubPointY(issuerKey),
    blindedX: jubjubPointX(blinded),
    blindedY: jubjubPointY(blinded),
    evaluatedX: jubjubPointX(evaluated),
    evaluatedY: jubjubPointY(evaluated),
    announcementGeneratorX: jubjubPointX(announcementGenerator),
    announcementGeneratorY: jubjubPointY(announcementGenerator),
    announcementBlindedX: jubjubPointX(announcementBlinded),
    announcementBlindedY: jubjubPointY(announcementBlinded)
  });

  // Compact 0.30.0 predates the public JubjubScalar type/cast. Keep the
  // Fiat–Shamir challenge below the scalar modulus by truncating the
  // field hash to 248 bits; this is still a full-entropy scalar challenge.
  return slice<31>(challengeField as Bytes<32>, 0) as Field;
}

export pure circuit verifyDleq(
  issuerKey: JubjubPoint,
  blinded: JubjubPoint,
  evaluated: JubjubPoint,
  proof: DleqProof
): Boolean {
  const challenge = dleqChallenge(
    issuerKey,
    blinded,
    evaluated,
    proof.announcementGenerator,
    proof.announcementBlinded
  );

  const generatorLeft = ecMulGenerator(proof.response);
  const generatorRight = ecAdd(
    proof.announcementGenerator,
    ecMul(issuerKey, challenge)
  );
  const blindedLeft = ecMul(blinded, proof.response);
  const blindedRight = ecAdd(
    proof.announcementBlinded,
    ecMul(evaluated, challenge)
  );

  return pointCoordinatesEqual(generatorLeft, generatorRight) &&
    pointCoordinatesEqual(blindedLeft, blindedRight);
}

export pure circuit nextFilingHistory(
  current: FilingHistory,
  slotKey: Bytes<32>,
  nextSalt: Bytes<32>
): FilingHistory {
  return FilingHistory {
    slots: [
      current.length == 0 ? slotKey : current.slots[0],
      current.length == 1 ? slotKey : current.slots[1],
      current.length == 2 ? slotKey : current.slots[2],
      current.length == 3 ? slotKey : current.slots[3]
    ],
    commitmentSalts: [
      current.length == 0 ? nextSalt : current.commitmentSalts[0],
      current.length == 1 ? nextSalt : current.commitmentSalts[1],
      current.length == 2 ? nextSalt : current.commitmentSalts[2],
      current.length == 3 ? nextSalt : current.commitmentSalts[3]
    ],
    length: (current.length + 1) as Uint<8>
  };
}

pure circuit latestHistorySalt(current: FilingHistory): Bytes<32> {
  return current.length == 1 ? current.commitmentSalts[0]
    : current.length == 2 ? current.commitmentSalts[1]
    : current.length == 3 ? current.commitmentSalts[2]
    : current.commitmentSalts[3];
}

export circuit file(
  ciphertext: Bytes<128>
): Boolean {
  const secret = filerSecret();
  const currentHistory = filingHistory();
  const blinded = blindedOprfPoint();
  const evaluated = evaluatedOprfPoint();
  const proof = issuerDleqProof();
  const issuerKey = constructJubjubPoint(issuerKeyX, issuerKeyY);

  assert(verifyDleq(issuerKey, blinded, evaluated, proof), "invalid issuer OPRF proof");

  const slotPoint = ecMul(evaluated, unblindingScalar());
  const slotKey = slotKeyFromPoint(slotPoint);
  const nullifier = filerNullifier(secret, slotKey);
  const filerId = filerIdFromSecret(secret);
  const cipherId = ciphertextId(ciphertext);

  assert(!filed.member(disclose(nullifier)), "this filer already filed on this slot");
  assert(!ciphertextsUsed.member(disclose(cipherId)), "ciphertext has already been filed");
  assert(currentHistory.length < 4 as Uint<8>, "private filing history is full");

  const openedHistory = persistentCommit<FilingHistory>(
    currentHistory,
    previousHistorySalt()
  );
  if (history.member(disclose(filerId))) {
    assert(history.lookup(disclose(filerId)) == openedHistory, "stale history commitment");
    assert(
      previousHistorySalt() == latestHistorySalt(currentHistory),
      "history opening salt does not match the latest state"
    );
  } else {
    assert(currentHistory.length == 0 as Uint<8>, "history must start empty");
  }

  for (const i of 0..4) {
    assert(currentHistory.length <= i || currentHistory.slots[i] != slotKey,
      "slot already exists in private filing history");
    assert(currentHistory.length <= i || currentHistory.commitmentSalts[i] != nextHistorySalt(),
      "history commitment salt was reused");
  }

  const nextHistory = nextFilingHistory(currentHistory, slotKey, nextHistorySalt());
  const nextCommitment = persistentCommit<FilingHistory>(nextHistory, nextHistorySalt());

  const priorCount = slotFilled.member(disclose(slotKey))
    ? slotFilled.lookup(disclose(slotKey))
    : 0 as Uint<8>;
  assert(priorCount < threshold, "slot is already unlocked");

  const nextCount = (priorCount + 1) as Uint<8>;
  const reachedThreshold = disclose(nextCount >= threshold);
  const newEntryKey = entryKey(slotKey, priorCount);

  filed.insert(disclose(nullifier));
  ciphertextsUsed.insert(disclose(cipherId));
  entries.insert(disclose(newEntryKey), disclose(ciphertext));
  slotFilled.insert(disclose(slotKey), disclose(nextCount));
  history.insert(disclose(filerId), disclose(nextCommitment));

  if (reachedThreshold) {
    unlocked.insert(disclose(slotKey));
  }

  return reachedThreshold;
}
